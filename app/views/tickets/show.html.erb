<% content_for :title, "##{@ticket.id.to_s.rjust(4, '0')} #{@ticket.subject} — İzlek" %>
<% content_for :page_heading, "##{@ticket.id.to_s.rjust(4, '0')}" %>
<section class="page-content ticket-detail-page">
  <div class="detail-back-row"><%= link_to "← #{t('tickets.detail_back')}", root_path, class: "back-link" %><span class="detail-updated"><%= t("tickets.last_update") %> <%= localized_time_ago(@ticket.updated_at) %></span></div>
  <div class="detail-layout">
    <article class="detail-main">
      <div class="detail-title-card"><div class="detail-title-meta"><span class="ticket-number big-number">#<%= @ticket.id.to_s.rjust(4, "0") %></span><span class="status-badge status-<%= @ticket.status %>"><i></i><%= status_label(@ticket.status) %></span><span class="priority-pill priority-<%= @ticket.priority %>"><i></i><%= priority_label(@ticket.priority) %></span></div><h1><%= @ticket.subject %></h1><p><%= @ticket.description %></p><div class="requester-line"><span class="avatar avatar-customer"><%= initials(@ticket.requester_display_name) %></span><span><strong><%= @ticket.requester_display_name %></strong><small><%= @ticket.requester_display_email %> · <%= l(@ticket.created_at, format: "%d %b, %H:%M") %></small></span></div></div>
      <div class="timeline-heading"><strong><%= t("tickets.conversation") %></strong><span><%= @ticket.replies.count + 1 %> <%= t("tickets.replies") %></span></div>
      <div class="conversation"><div class="conversation-item"><span class="avatar avatar-customer"><%= initials(@ticket.requester_display_name) %></span><div class="conversation-body"><div class="conversation-meta"><strong><%= @ticket.requester_display_name %></strong><span><%= t("tickets.requester") %></span><time><%= l(@ticket.created_at, format: "%d %b, %H:%M") %></time></div><p><%= @ticket.description %></p></div></div>
        <% @ticket.replies.order(:created_at).each do |reply| %><div class="conversation-item"><span class="avatar <%= reply.user&.support_staff? ? 'avatar-self' : 'avatar-customer' %>"><%= initials(reply.author_name) %></span><div class="conversation-body"><div class="conversation-meta"><strong><%= reply.author_name %></strong><span><%= reply.user ? role_label(reply.user.role) : t("tickets.support_team") %></span><time><%= l(reply.created_at, format: "%d %b, %H:%M") %></time></div><p><%= reply.body %></p></div></div><% end %>
      </div>
      <% if @ticket.status != "solved" || current_user.requester? %><%= form_with model: [@ticket, @reply], url: replies_ticket_path(@ticket), class: "reply-card" do |form| %><div class="reply-header"><span class="avatar avatar-self"><%= initials(current_user.name) %></span><strong><%= current_user.name %></strong><span><%= t("tickets.reply_to_customer") %></span></div><%= form.text_area :body, rows: 4, placeholder: t("tickets.reply_placeholder"), required: true %><div class="reply-footer"><span><%= t("tickets.reply_sla_hint") %></span><%= form.submit t("tickets.send_reply"), class: "button button-primary button-small" %></div><% end %><% end %>
    </article>
    <aside class="detail-sidebar">
      <section class="action-card"><div class="side-card-heading"><strong><%= t("tickets.next_step") %></strong><span class="sparkle">✦</span></div><p class="next-action"><%= @ticket.next_action %></p>
        <% if current_user.support_staff? && @ticket.status == "new" %><%= button_to t("tickets.open_ticket"), open_ticket_path(@ticket), method: :patch, class: "button button-primary action-full" %>
        <% elsif current_user.support_staff? && @ticket.status == "open" %><%= button_to t("tickets.mark_solved"), solve_ticket_path(@ticket), method: :patch, class: "button button-green action-full" %>
        <% elsif @ticket.status == "solved" && current_user.requester? %><%= button_to t("tickets.reopen"), reopen_ticket_path(@ticket), method: :post, class: "button button-secondary action-full" %>
        <% else %><span class="status-note"><%= status_label(@ticket.status) %></span><% end %></section>
      <section class="side-info-card"><div class="side-card-heading"><strong><%= t("tickets.ticket_info") %></strong><span class="edit-mark">⌁</span></div><div class="info-field"><label><%= t("tickets.status") %></label><span class="status-badge status-<%= @ticket.status %>"><i></i><%= status_label(@ticket.status) %></span></div><div class="info-field"><label><%= t("tickets.priority_label") %></label><span class="priority-pill priority-<%= @ticket.priority %>"><i></i><%= priority_label(@ticket.priority) %></span></div>
        <% if current_user.support_staff? %><div class="info-field"><label><%= t("tickets.assignee") %></label><%= form_with url: assign_ticket_path(@ticket), method: :patch, class: "assign-form" do |form| %><span class="avatar"><%= @ticket.assignee_user ? initials(@ticket.assignee_user.name) : "—" %></span><%= form.select :assignee_user_id, [[t("tickets.unassigned"), ""], *@agents.map { |agent| [agent.name, agent.id] }], { selected: @ticket.assignee_user_id }, onchange: "this.form.requestSubmit()", aria: { label: t("tickets.assignee") } %><% end %></div><% end %>
        <div class="info-field"><label><%= t("tickets.first_response_sla") %></label><span class="sla-pill sla-<%= @ticket.sla_state %>"><i></i><%= @ticket.first_response_due? ? @ticket.sla_remaining : t("tickets.answered") %></span></div><div class="sla-explainer"><span class="sla-clock">◷</span><span><%= t("tickets.sla_due") %><strong><%= l(@ticket.response_due_at, format: "%d %b, %H:%M") %></strong><small><%= t("tickets.four_hours_after") %></small></span></div></section>
      <section class="customer-card"><span class="customer-card-icon">◎</span><div><small><%= t("tickets.requester_info").upcase %></small><strong><%= @ticket.requester_display_name %></strong><a href="mailto:<%= @ticket.requester_display_email %>"><%= @ticket.requester_display_email %></a></div></section>
    </aside>
  </div>
</section>
