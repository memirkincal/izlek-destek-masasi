<% content_for :title, "##{@ticket.id.to_s.rjust(4, '0')} #{@ticket.subject} — İzlek" %>
<% content_for :page_heading, "Talep ##{@ticket.id.to_s.rjust(4, '0')}" %>
<section class="page-content ticket-detail-page">
  <div class="detail-back-row"><%= link_to "← Gelen kutusuna dön", root_path, class: "back-link" %><span class="detail-updated">Son güncelleme <%= localized_time_ago(@ticket.updated_at) %> önce</span></div>
  <div class="detail-layout">
    <article class="detail-main">
      <div class="detail-title-card"><div class="detail-title-meta"><span class="ticket-number big-number">#<%= @ticket.id.to_s.rjust(4, "0") %></span><span class="status-badge status-<%= @ticket.status %>"><i></i><%= status_label(@ticket.status) %></span><span class="priority-pill priority-<%= @ticket.priority %>"><i></i><%= priority_label(@ticket.priority) %></span></div><h1><%= @ticket.subject %></h1><p><%= @ticket.description %></p><div class="requester-line"><span class="avatar avatar-customer"><%= initials(@ticket.requester_name) %></span><span><strong><%= @ticket.requester_name %></strong><small><%= @ticket.requester_email %> · <%= l(@ticket.created_at, format: "%d %b, %H:%M") %></small></span></div></div>
      <div class="timeline-heading"><strong>Konuşma</strong><span><%= @ticket.replies.count %> yanıt</span></div>
      <div class="conversation"><div class="conversation-item"><span class="avatar avatar-customer"><%= initials(@ticket.requester_name) %></span><div class="conversation-body"><div class="conversation-meta"><strong><%= @ticket.requester_name %></strong><span>Müşteri</span><time><%= l(@ticket.created_at, format: "%d %b, %H:%M") %></time></div><p><%= @ticket.description %></p></div></div>
        <% @ticket.replies.order(:created_at).each do |reply| %><div class="conversation-item"><span class="avatar avatar-self"><%= initials(reply.author_name) %></span><div class="conversation-body"><div class="conversation-meta"><strong><%= reply.author_name %></strong><span>Destek ekibi</span><time><%= l(reply.created_at, format: "%d %b, %H:%M") %></time></div><p><%= reply.body %></p></div></div><% end %>
      </div>
      <% unless @ticket.status == "solved" %><%= form_with model: [@ticket, @reply], url: replies_ticket_path(@ticket), class: "reply-card" do |form| %><div class="reply-header"><span class="avatar avatar-self">ED</span><strong>Ece Demir</strong><span>müşteriye yanıt veriyor</span></div><%= form.text_area :body, rows: 4, placeholder: "Yanıtını buraya yaz…", required: true %><div class="reply-footer"><span>Yanıt gönderildiğinde ilk yanıt SLA'sı durur.</span><%= form.submit "Yanıt gönder", class: "button button-primary button-small" %></div><% end %><% end %>
    </article>
    <aside class="detail-sidebar">
      <section class="action-card"><div class="side-card-heading"><strong>Sıradaki adım</strong><span class="sparkle">✦</span></div><p class="next-action"><%= @ticket.next_action %></p><% if @ticket.status == "new" %><%= button_to "Talebi aç", open_ticket_path(@ticket), method: :patch, class: "button button-primary action-full" %><% elsif @ticket.status == "open" %><%= button_to "Çözüldü olarak işaretle", solve_ticket_path(@ticket), method: :patch, class: "button button-green action-full" %><% else %><%= button_to "Yeniden aç", reopen_ticket_path(@ticket), method: :post, class: "button button-secondary action-full" %><% end %></section>
      <section class="side-info-card"><div class="side-card-heading"><strong>Talep bilgileri</strong><span class="edit-mark">⌁</span></div><div class="info-field"><label>Durum</label><span class="status-badge status-<%= @ticket.status %>"><i></i><%= status_label(@ticket.status) %></span></div><div class="info-field"><label>Öncelik</label><span class="priority-pill priority-<%= @ticket.priority %>"><i></i><%= priority_label(@ticket.priority) %></span></div><div class="info-field"><label>Sorumlu</label><%= form_with url: assign_ticket_path(@ticket), method: :patch, class: "assign-form" do |form| %><span class="avatar avatar-<%= @ticket.assignee.to_s.parameterize %>"><%= @ticket.assignee.present? ? initials(@ticket.assignee) : "—" %></span><%= form.select :assignee, [["Atanmadı", ""], *Ticket::AGENTS.map { |agent| [agent, agent] }], { selected: @ticket.assignee }, onchange: "this.form.requestSubmit()", aria: { label: "Talep sorumlusu" } %><% end %></div><div class="info-field"><label>İlk yanıt SLA</label><span class="sla-pill sla-<%= @ticket.sla_state %>"><i></i><%= @ticket.first_response_due? ? @ticket.sla_remaining : "Yanıtlandı" %></span></div><div class="sla-explainer"><span class="sla-clock">◷</span><span>İlk yanıt hedefi: <strong><%= l(@ticket.response_due_at, format: "%d %b, %H:%M") %></strong><small>Talep açıldıktan 4 saat sonra</small></span></div></section>
      <section class="customer-card"><span class="customer-card-icon">◎</span><div><small>MÜŞTERİ</small><strong><%= @ticket.requester_name %></strong><a href="mailto:<%= @ticket.requester_email %>"><%= @ticket.requester_email %></a></div></section>
    </aside>
  </div>
</section>
