<% content_for :title, "Yeni talep — İzlek" %>
<% content_for :page_heading, "Yeni talep" %>
<section class="page-content narrow-page">
  <div class="page-heading-row"><div><div class="eyebrow">GELEN KUTUSU / YENİ</div><h1>Yeni talep oluştur</h1><p class="page-subtitle">Talep kaydedildiğinde ilk yanıt için dört saatlik SLA başlar.</p></div><%= link_to "← Gelen kutusu", root_path, class: "back-link" %></div>
  <%= form_with model: @ticket, class: "form-card" do |form| %>
    <% if @ticket.errors.any? %><div class="form-errors"><strong>Talep kaydedilemedi.</strong><ul><% @ticket.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
    <div class="form-section-title"><span class="form-section-icon">01</span><div><strong>Müşteri bilgileri</strong><small>Yanıtın kime gideceğini belirt.</small></div></div>
    <div class="form-grid"><div class="field"><%= form.label :requester_name, "Ad soyad" %><%= form.text_field :requester_name, placeholder: "Örn. Ada Yılmaz", required: true %></div><div class="field"><%= form.label :requester_email, "E-posta adresi" %><%= form.email_field :requester_email, placeholder: "ada@ornek.com", required: true %></div></div>
    <div class="form-section-title section-spaced"><span class="form-section-icon">02</span><div><strong>Sorun detayları</strong><small>Ekibin hızlıca anlayabilmesi için açıklayıcı ol.</small></div></div>
    <div class="field"><%= form.label :subject, "Konu" %><%= form.text_field :subject, placeholder: "Örn. Faturama ulaşamıyorum", maxlength: 120, required: true %></div>
    <div class="field"><%= form.label :description, "Açıklama" %><%= form.text_area :description, rows: 5, placeholder: "Müşterinin yaşadığı sorunu ve denediği adımları yaz…", required: true %></div>
    <div class="field"><%= form.label :priority, "Öncelik" %><%= form.select :priority, [["Düşük", "low"], ["Normal", "normal"], ["Yüksek", "high"], ["Acil", "urgent"]], {}, class: "select-input" %></div>
    <div class="form-footer"><span><span class="lock-icon">◷</span> İlk yanıt süresi: <strong>4 saat</strong></span><%= form.submit "Talebi oluştur", class: "button button-primary" %></div>
  <% end %>
</section>
