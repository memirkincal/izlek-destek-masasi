<% content_for :title, "#{t('auth.create_workspace')} — İzlek" %>
<section class="auth-page">
  <div class="auth-decoration auth-decoration-one"></div><div class="auth-decoration auth-decoration-two"></div>
  <div class="auth-card auth-card-wide">
    <span class="auth-mark"><svg viewBox="0 0 32 32"><path d="M6 18.5 13.3 26 26 7"/><path d="M5 9.5h8"/></svg></span>
    <div class="eyebrow">İZLEK · <%= t("auth.create_workspace") %></div>
    <h1><%= t("auth.register_title") %></h1>
    <p class="auth-subtitle"><%= t("auth.register_subtitle") %></p>
    <%= form_with url: registrations_path, class: "auth-form" do |form| %>
      <% if @organization.errors.any? || @user.errors.any? %>
        <div class="form-errors"><strong><%= t("errors.form_title") %></strong><ul><% (@organization.errors.full_messages + @user.errors.full_messages).uniq.each do |message| %><li><%= message %></li><% end %></ul></div>
      <% end %>
      <div class="field"><%= label_tag "organization_name", t("auth.organization") %><%= text_field_tag "organization[name]", @organization.name, required: true, maxlength: 100, autocomplete: "organization" %></div>
      <div class="field"><%= form.label :name, t("auth.name") %><%= form.text_field "user[name]", value: @user.name, required: true, maxlength: 80, autocomplete: "name" %></div>
      <div class="field"><%= form.label :email_address, t("auth.email") %><%= form.email_field "user[email_address]", value: @user.email_address, required: true, autocomplete: "email" %></div>
      <div class="form-grid auth-password-grid"><div class="field"><%= form.label :password, t("auth.password") %><%= form.password_field "user[password]", required: true, minlength: 8, autocomplete: "new-password" %></div><div class="field"><%= form.label :password_confirmation, t("auth.password_confirmation") %><%= form.password_field "user[password_confirmation]", required: true, minlength: 8, autocomplete: "new-password" %></div></div>
      <%= form.submit t("auth.create_workspace"), class: "button button-primary auth-submit" %>
    <% end %>
    <div class="auth-divider"><span><%= link_to t("auth.sign_in"), new_session_path, class: "text-link" %></span></div>
  </div>
  <p class="auth-footnote"><%= t("auth.footer_note") %></p>
</section>
