<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "İzlek — #{t('nav.inbox')}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f5f6f8">
    <meta name="description" content="İzlek — clear, human-centered customer support workflows.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "ui", defer: true %>
  </head>
  <body class="<%= current_user ? 'signed-in' : 'public-page' %>">
    <% if current_user %>
      <div class="app-shell">
        <aside class="sidebar">
          <a class="brand" href="<%= root_path %>"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M6 18.5 13.3 26 26 7"/><path d="M5 9.5h8"/></svg></span><span><strong>izlek</strong><small><%= t("nav.inbox") %></small></span></a>
          <div class="workspace-label"><%= t("nav.workspace") %></div>
          <div class="workspace-chip"><span class="workspace-orb"><%= initials(current_user.organization.name) %></span><span><strong><%= current_user.organization.name %></strong><small><%= role_label(current_user.role) %></small></span><span class="workspace-chevron">⌄</span></div>
          <nav class="main-nav" aria-label="<%= t('nav.workspace') %>">
            <a class="nav-link <%= current_page?(root_path) ? 'active' : '' %>" href="<%= root_path %>"><span class="nav-icon">▦</span><%= t("nav.inbox") %><span class="nav-count"><%= current_user.requester? ? current_user.requested_tickets.active.count : current_user.organization.tickets.active.count %></span></a>
            <% if current_user.requester? %><a class="nav-link nav-assistant-primary <%= current_page?(support_agent_path) ? 'active' : '' %>" href="<%= support_agent_path %>"><span class="nav-icon">✦</span><%= t("nav.ask_ai") %></a><% end %>
            <% if current_user.support_staff? %><a class="nav-link <%= params[:filter] == 'unassigned' ? 'active' : '' %>" href="<%= tickets_path(filter: 'unassigned') %>"><span class="nav-icon">◉</span><%= t("nav.unassigned") %><span class="nav-count"><%= current_user.organization.tickets.active.where(assignee_user_id: nil).count %></span></a><% end %>
            <% if current_user.support_staff? %><a class="nav-link <%= controller_name == 'knowledge_articles' ? 'active' : '' %>" href="<%= knowledge_articles_path %>"><span class="nav-icon">▤</span><%= t("nav.knowledge") %></a><% end %>
          </nav>
          <div class="side-section-title"><%= t("nav.statuses") %></div>
          <nav class="main-nav" aria-label="<%= t('nav.statuses') %>">
            <a class="nav-link" href="<%= tickets_path(filter: 'new') %>"><span class="status-dot dot-new"></span><%= t("nav.new") %></a>
            <a class="nav-link" href="<%= tickets_path(filter: 'open') %>"><span class="status-dot dot-open"></span><%= t("nav.open") %></a>
            <a class="nav-link" href="<%= tickets_path(filter: 'solved') %>"><span class="status-dot dot-solved"></span><%= t("nav.solved") %></a>
            <% if current_user.admin? %><a class="nav-link <%= current_page?(team_members_path) ? 'active' : '' %>" href="<%= team_members_path %>"><span class="nav-icon">♧</span><%= t("nav.team") %><span class="nav-count"><%= current_user.organization.users.count %></span></a><% end %>
          </nav>
          <div class="sidebar-bottom">
            <div class="team-card"><div class="team-avatars"><% current_user.organization.users.where(role: %w[admin agent]).order(:name).limit(3).each do |member| %><span title="<%= member.name %>"><%= initials(member.name) %></span><% end %></div><div><strong><%= t("nav.team") %></strong><small><%= t("team.members_count", count: current_user.organization.users.count) %></small></div><i></i></div>
            <div class="profile-row"><div class="avatar avatar-self"><%= initials(current_user.name) %></div><div class="profile-copy"><strong><%= current_user.name %></strong><small><%= role_label(current_user.role) %></small></div><%= button_to t("nav.sign_out"), session_path, method: :delete, class: "signout-button" %></div>
          </div>
        </aside>
        <main class="main-content">
          <header class="topbar"><div class="breadcrumbs"><span><%= current_user.organization.name %></span><span class="crumb-sep">/</span><strong><%= content_for(:page_heading) || t("nav.inbox") %></strong></div><div class="topbar-right"><span class="live-indicator"><i></i><%= t("nav.online") %></span><span class="topbar-divider"></span><div class="locale-switch" aria-label="Language"><%= link_to "TR", url_for(request.query_parameters.merge(locale: "tr")), class: I18n.locale == :tr ? "active" : "" %><%= link_to "EN", url_for(request.query_parameters.merge(locale: "en")), class: I18n.locale == :en ? "active" : "" %></div></div></header>
          <%= render "shared/flash_messages" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <div class="public-topbar"><a class="brand" href="<%= new_session_path %>"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M6 18.5 13.3 26 26 7"/><path d="M5 9.5h8"/></svg></span><span><strong>izlek</strong><small><%= t("nav.product_subtitle") %></small></span></a><div class="locale-switch"><%= link_to "TR", url_for(request.query_parameters.merge(locale: "tr")), class: I18n.locale == :tr ? "active" : "" %><%= link_to "EN", url_for(request.query_parameters.merge(locale: "en")), class: I18n.locale == :en ? "active" : "" %></div></div>
      <%= render "shared/flash_messages" %>
      <%= yield %>
    <% end %>
  </body>
</html>
