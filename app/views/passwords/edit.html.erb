<% content_for :title, "#{t('auth.reset_title')} — İzlek" %>
<section class="auth-page">
  <div class="auth-decoration auth-decoration-one"></div><div class="auth-decoration auth-decoration-two"></div>
  <div class="auth-card">
    <span class="auth-mark"><svg viewBox="0 0 32 32"><path d="M6 18.5 13.3 26 26 7"/><path d="M5 9.5h8"/></svg></span>
    <div class="eyebrow">İZLEK · <%= t("auth.password") %></div>
    <h1><%= t("auth.reset_title") %></h1>
    <%= form_with url: password_path(params[:token]), method: :put, class: "auth-form" do |form| %>
      <div class="field"><%= form.label :password, t("auth.password") %><%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password", placeholder: t("auth.password_placeholder"), maxlength: 72 %></div>
      <div class="field"><%= form.label :password_confirmation, t("auth.password_confirmation") %><%= form.password_field :password_confirmation, required: true, minlength: 8, autocomplete: "new-password", placeholder: t("auth.password_confirmation"), maxlength: 72 %></div>
      <%= form.submit t("auth.save_password"), class: "button button-primary auth-submit" %>
    <% end %>
  </div>
  <p class="auth-footnote"><%= t("auth.footer_note") %></p>
</section>
