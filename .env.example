# Supabase PostgreSQL Session Pooler (Frankfurt, IPv4).
# Replace the placeholder with the real database password. URL-encode any
# special characters in the password. Keep this example file secret-free.
DATABASE_URL=postgresql://postgres.xixlqruqhjaixdmxuixm:<PERCENT_ENCODED_DATABASE_PASSWORD>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Production only: set this to the contents of config/master.key in the
# hosting provider's secret settings. Never commit the real key.
RAILS_MASTER_KEY=<CONTENTS_OF_CONFIG_MASTER_KEY>

# Optional production mail delivery for password resets.
