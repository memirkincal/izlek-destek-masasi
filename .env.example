# Optional local PostgreSQL or Supabase Session pooler connection.
# Keep real credentials in your shell or hosting provider's secret settings.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require

# Production only: copy the value from config/master.key into the host's secret store.
# Never commit a real key or put it in this example file.
# RAILS_MASTER_KEY=
